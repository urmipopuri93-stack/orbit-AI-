{
  "manifest_version": 3,
  "name": "OrbitAI",
  "version": "1.0",
  "description": "AI-powered learning assistant for YouTube videos",

  "permissions": [
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1:8000/*"
  ],

  "action": {
    "default_popup": "index.html"
  },

  "icons": {
    "16": "public/favicon.svg",
    "48": "public/favicon.svg",
    "128": "public/favicon.svg"
  }
}